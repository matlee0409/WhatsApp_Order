# ─── Paystack ──────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# ─── Google Sheets ─────────────────────────────────────────────────────────
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_CREDENTIALS_FILE=credentials.json

# ─── Twilio WhatsApp ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
PUBLIC_WEBHOOK_URL=https://your-domain/whatsapp/webhook

# ─── Telegram (OUTBOUND owner notifications only) ──────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ─── Anthropic (Claude — order parsing only) ───────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Brevo (optional email receipts) ───────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# ─── App ───────────────────────────────────────────────────────────────────
FLASK_ENV=production
PORT=5003
PICKUP_ADDRESS=123 Example Street Lagos
BUSINESS_NAME=Your Business Name
BUSINESS_EMAIL=your@businessemail.com
