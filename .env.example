# ─── Paystack ──────────────────────────────────────────────────────────────
# ─── Google Sheets ─────────────────────────────────────────────────────────
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_CREDENTIALS_FILE=credentials.json

# ─── Zernio WhatsApp connection ────────────────────────────────────────────
ZERNIO_API_BASE_URL=https://zernio.com/api
ZERNIO_API_KEY=your_zernio_api_key
# Optional: the app creates or reuses a profile automatically when omitted.
ZERNIO_PROFILE_ID=
ZERNIO_PROFILE_NAME=
# Optional: defaults to the current public deployment host.
ZERNIO_REDIRECT_URI=
# Generate a persistent value in Railway; do not use a rotating runtime value.
ZERNIO_WEBHOOK_SECRET=
# Optional: set only if Zernio exposes a Meta catalog ID for native shopping.
ZERNIO_CATALOG_ID=

# ─── Telegram (OUTBOUND owner notifications only) ──────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ─── Brevo (optional email receipts) ───────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# ─── App ───────────────────────────────────────────────────────────────────
FLASK_ENV=production
PORT=5003
PICKUP_ADDRESS=123 Example Street Lagos
BUSINESS_NAME=Your Business Name
BUSINESS_EMAIL=your@businessemail.com

# Dashboard authentication (required in production)
DASHBOARD_PASSWORD=replace_with_a_strong_password
# Generate a persistent value in Railway; use at least 32 random bytes.
FLASK_SECRET=
